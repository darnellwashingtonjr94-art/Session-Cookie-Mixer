{
  "manifest_version": 3,
  "name": "Session Cookie Mixer: AI Edition",
  "version": "2.0.0",
  "description": "Uses Gemini to generate hyper-realistic synthetic cookies on startup for privacy noise.",
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
